{
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32-s3-dualeye-lcd-0.71",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_BLE_DATA_SERVICE=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1"
            ]
        }
    ]
}